{
  "name": "agentia-complete-example",
  "private": true,
  "type": "module",
  "description": "Agentia 完整示例：四类单元 + 三种触发 + 鉴权 + 全观测栈 + 优雅停机",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "serve": "node dist/main.js"
  },
  "dependencies": {
    "@migor/agentia": "file:../..",
    "@migor/agentia-observability": "file:../observability"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
