# 复制成 .env 再填值（.env 已 gitignore）

# —— 模型凭据：二选一 ——
# A) Anthropic（缺省路径）
ANTHROPIC_API_KEY=sk-ant-...
# B) OpenAI 兼容端点（DeepSeek / vLLM / Ollama…）—— 设了 OPENAI_BASE_URL 就走它
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# AGENTIA_MODEL=deepseek-chat

# —— 可选 ——
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AGENTIA_MODEL=claude-opus-5
# PORT=3000
# AGENTIA_DB=agentia.db
# AGENTIA_SAMPLE_RATE=0.1            # 采样率 [0,1]；错误 run 一律保留。示例默认 1（全留）
# AGENTIA_CHECK_INTERVAL_MS=60000    # 定时任务间隔；0 = 关闭（默认）
# API_KEY=some-secret                # 设了就要求 x-api-key 头；不设 = 不鉴权
