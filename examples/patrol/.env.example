# 复制成 .env 再填值（.env 已 gitignore，不要提交）

# —— 模型（框架不读 env，是本进程读；deployment.md §1）——
DEEPSEEK_API_KEY=sk-...
# 可选
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AGENTIA_MODEL=deepseek-v4-pro

# —— 入口鉴权（§3）——
# 没设它服务会拒绝启动，除非显式认领「只有反代可达」
PATROL_TOKEN=换成一个随机串

# —— 巡检目标与产出 ——
# PATROL_ROOT=./sample-workspace
# PATROL_REPORTS=./patrol-reports
# PATROL_DB=./patrol.db
# 想用内存库就写 `:memory:`（原样交给 SQLite；进程一停记录就没了，只适合试跑）
# PATROL_DB=:memory:

# —— 预算保险丝（§6）——
# 价目表**必须**填你端点的真实价，否则 maxCostUsd 会静默不生效
PATROL_PRICE_IN=1
PATROL_PRICE_OUT=2
# PATROL_MAX_TOKENS=200000
# PATROL_MAX_COST_USD=2
# PATROL_MAX_ITERATIONS=24
# PATROL_APPROVAL_TIMEOUT_MS=900000

# —— 停机（§5）：PATROL_DRAIN_TIMEOUT_MS 必须**小于**编排器的停机宽限 ——
# PATROL_DRAIN_TIMEOUT_MS=15000
