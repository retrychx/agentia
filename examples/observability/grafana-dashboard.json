{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "run 受理速率与失败速率（agentia_runs_total / agentia_runs_failed_total）",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(agentia_runs_total[$__rate_interval]))",
          "legendFormat": "runs/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(agentia_runs_failed_total[$__rate_interval]))",
          "legendFormat": "failed/s",
          "refId": "B"
        }
      ],
      "title": "Run 速率（总量 / 失败）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "token 消耗速率，按 kind 拆分（agentia_tokens_total{kind}）",
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (kind) (rate(agentia_tokens_total[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "title": "Token 速率（按 kind）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "累计成本估算（agentia_cost_usd_total，依赖模型在价格表内）",
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "agentia_cost_usd_total",
          "legendFormat": "cost usd（累计）",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(agentia_cost_usd_total[$__rate_interval]))",
          "legendFormat": "cost usd/s",
          "refId": "B"
        }
      ],
      "title": "成本（美元）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "run 时长分位（agentia_run_duration_ms_last{quantile}，滑动窗口内精确值；跨实例聚合请用 agentia_run_duration_ms histogram）",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "agentia_run_duration_ms_last{quantile=\"0.5\"}",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "agentia_run_duration_ms_last{quantile=\"0.95\"}",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Run 时长 p50 / p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "能力调用量 Top10 与失败量 Top10（agentia_capability_calls_total / agentia_capability_errors_total）",
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {},
        "valueMode": "color"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, sum by (capability) (increase(agentia_capability_calls_total[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{capability}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "topk(10, sum by (capability) (increase(agentia_capability_errors_total[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{capability}} errors",
          "refId": "B"
        }
      ],
      "title": "能力调用 / 失败 Top10（时间窗内增量）",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "质量评分（agentia_score gauge：最近一次值，label 为评分维度 name × 来源 source；由 attachScore 写入 —— LLM-judge / eval / 人工标注）",
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "agentia_score",
          "legendFormat": "{{name}} @ {{source}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (name, source) (rate(agentia_score_total[$__rate_interval]))",
          "legendFormat": "{{name}} @ {{source}} 条数/s",
          "refId": "B"
        }
      ],
      "title": "评分（agentia_score，0–1）",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["agentia"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "definition": "",
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus 数据源",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Agentia 服务观测",
  "uid": "agentia-observability",
  "version": 1,
  "weekStart": ""
}
