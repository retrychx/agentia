---
// 自动迁移自 public/index.html（body 内容抽到 src/fragments/index.html，经 ?raw 原样注入）。
// 页面外壳（head/nav/footer）由 Base 统一提供。
import Base from '../layouts/Base.astro';
import content from '../fragments/index.html?raw';
// 首屏 trace 自播用的调用树样式 —— 与 playground 页同一份（渲染器抽在 @migor/trace-view）
import '@migor/trace-view/style.css';

const footerLinks = [
    { href: 'https://github.com/retrychx/agentia', label: 'GitHub', external: true },
    { href: 'https://www.npmjs.com/package/@migor/agentia', label: '@migor/agentia', external: true },
    { href: 'https://www.npmjs.com/package/@migor/cli', label: '@migor/cli', external: true },
];
---
<Base title='Agentia — 声明式 Agent 服务开发框架' description='面向应用开发的声明式 agent 服务开发框架：装饰器 + DI 声明四类能力，主 agent 编排执行；每次 run 产出结构化结果与可观测调用树（trace、成本、指标），交付可直接上线的服务。' page='home' footerLinks={footerLinks}>
  <Fragment set:html={content} />

  <script>
    import '../scripts/site.js';
    import '../scripts/hero-trace.js';
  </script>
</Base>
