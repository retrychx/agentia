---
// 自动迁移自 public/playground.html（body 内容抽到 src/fragments/playground.html，经 ?raw 原样注入）。
// 页面外壳（head/nav/footer）由 Base 统一提供。
import Base from '../layouts/Base.astro';
import content from '../fragments/playground.html?raw';
// trace 调用树样式（.tr-*）来自共享包 —— 官网与 CLI inspector 同一份，避免渲染漂移
import '@migor/trace-view/style.css';

const footerLinks = [
    { href: '/', label: '首页' },
    { href: '/docs', label: '文档' },
    { href: 'https://github.com/retrychx/agentia', label: 'GitHub', external: true },
    { href: 'https://www.npmjs.com/package/@migor/agentia', label: '@migor/agentia', external: true },
];
---
<Base title='Playground — Agentia' description='Agentia Playground：主 agent 编排四类能力的运行回放 —— 在浏览器里直接看框架的可观测面（trace 调用树、token 与成本）随 run 同步生长。' page='playground' footerLinks={footerLinks}>
  <Fragment set:html={content} />

  <script>
    import '../scripts/playground-entry.js';
  </script>
</Base>
