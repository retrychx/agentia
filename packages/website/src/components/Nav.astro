---
// 顶部导航。page='home' 时用页内锚点（index 的 hero 分区），其余页走站内链接。
// 非首页默认带 scrolled（深色实底）；首页由 site.js 按滚动位置切换。
const { page = 'home' } = Astro.props;
const isHome = page === 'home';
---
<nav class:list={['nav', !isHome && 'scrolled']}>
  <div class="nav-inner">
    <a class="brand" href={isHome ? '#top' : './index.html'}>
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.6"></rect>
        <circle cx="16" cy="16" r="3.4" fill="currentColor"></circle>
        <circle cx="16" cy="7.6" r="1.8" fill="currentColor" opacity=".7"></circle>
        <circle cx="23.4" cy="20.6" r="1.8" fill="currentColor" opacity=".7"></circle>
        <circle cx="8.6" cy="20.6" r="1.8" fill="currentColor" opacity=".7"></circle>
      </svg>
      <span>Agentia</span>
    </a>
    <button class="nav-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="nav-links">
      {isHome ? (
        <>
          <a href="#units">单元</a>
          <a href="#features">特性</a>
          <a href="#quickstart">快速开始</a>
          <a href="./playground.html">Playground</a>
          <a href="./docs.html">文档</a>
          <a href="./api.html">API</a>
        </>
      ) : (
        <>
          <a href="./index.html">首页</a>
          <a href="./playground.html">Playground</a>
          <a href="./docs.html">文档</a>
          <a href="./api.html">API</a>
        </>
      )}
      <a href="https://github.com/retrychx/agentia" target="_blank" rel="noopener" class="nav-cta">GitHub ↗</a>
    </div>
  </div>
</nav>
