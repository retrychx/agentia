---
// 全站外壳：head（meta/字体/样式）+ 背景层 + Nav + 内容 + Footer。
// 四个页面共用，消除此前「nav/head/footer 各抄四遍」的重复。
//
// 注意：frontmatter 里的 import 在构建期（Node）执行；
// 客户端脚本一律走 <script> 标签（Astro 会打包并注入为 module）。
// 字体 @font-face 声明在 global.css 里（自己写、font-display: optional）——
// 不用 @fontsource 的 CSS，因为它的 font-display 固定 swap，会「先画系统字体再换一遍」。
// 这里只保留字体文件的 ?url 引用，供 head 里的 preload 使用（顺序须在 global.css 之前导入，
// 以便 Vite 把同一份字体文件哈希复用到 preload 的 href 上）。
import sg400 from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import sg500 from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import sg700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import jbm400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// 首屏字体 preload（修「换字抖动」）：字体只靠 CSS 引用就是**依赖式请求** ——
// 必须先下完并解析 CSS，浏览器才知道要下字体，于是字体总晚首屏一步。
// 这里用 `?url` 取 Vite 处理后的哈希地址，在样式表之前显式 preload，把字体并进首屏那一趟。
// `crossorigin` 必须有：字体按 CORS 模式取，同源也要带，否则 preload 命中不了、反而下两遍。
// 只 preload 首屏用得到的 4 个（正文 400 / 导航按钮 500 / 大标题 700 / 代码 400）；
// JetBrains Mono 500 只用于下方 mono 小标题，按需加载即可。
const preloadFonts = [sg400, sg500, sg700, jbm400];

const { title, description, page = 'home', footerLinks = [] } = Astro.props;

// 社交分享卡片（Open Graph / Twitter）：
// og:image 指向 public/og.png（1280×640、<1MB，与 GitHub Social preview 同一张）。
// 用 Astro.site 拼绝对 URL —— OG 规范要求 og:image / og:url 必须是绝对地址。
const site = Astro.site ?? new URL('https://agentia-web.pages.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('og.png', site).href;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="./favicon.svg" type="image/svg+xml" />
    <!-- 社交分享：Open Graph（Facebook/微信/Slack 等） + Twitter 大图卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agentia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Agentia —— 声明式 agent 服务开发框架" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {preloadFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
  </head>
  <body class={`page-${page}`}>
    <div class="grid-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress"></span></div>

    <Nav page={page} />

    <slot />

    <Footer links={footerLinks} />

    <slot name="scripts" />
  </body>
</html>

<script>
  // 窄屏导航折叠：零依赖，四页共用
  import '../scripts/nav-collapse.js';
</script>
