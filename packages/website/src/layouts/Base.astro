---
// 全站外壳：head（meta/字体/样式）+ 背景层 + Nav + 内容 + Footer。
// 四个页面共用，消除此前「nav/head/footer 各抄四遍」的重复。
//
// 注意：frontmatter 里的 import 在构建期（Node）执行；
// 客户端脚本一律走 <script> 标签（Astro 会打包并注入为 module）。
// 字体 @font-face 声明在 global.css 里（自己写、font-display: optional）——
// 不用 @fontsource 的 CSS，因为它的 font-display 固定 swap，会「先画系统字体再换一遍」。
// 这里只保留字体文件的 ?url 引用，供 head 里的 preload 使用（顺序须在 global.css 之前导入，
// 以便 Vite 把同一份字体文件哈希复用到 preload 的 href 上）。
import sg400 from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import sg500 from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import sg700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import jbm400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// 首屏字体 preload（修「换字抖动」）：字体只靠 CSS 引用就是**依赖式请求** ——
// 必须先下完并解析 CSS，浏览器才知道要下字体，于是字体总晚首屏一步。
// 这里用 `?url` 取 Vite 处理后的哈希地址，在样式表之前显式 preload，把字体并进首屏那一趟。
// `crossorigin` 必须有：字体按 CORS 模式取，同源也要带，否则 preload 命中不了、反而下两遍。
// 只 preload 首屏用得到的 4 个（正文 400 / 导航按钮 500 / 大标题 700 / 代码 400）；
// JetBrains Mono 500 只用于下方 mono 小标题，按需加载即可。
const preloadFonts = [sg400, sg500, sg700, jbm400];

const { title, description, page = 'home', footerLinks = [], lang = 'zh' } = Astro.props;

// 社交分享卡片（Open Graph / Twitter）：
// og:image 指向 public/og.png（1280×640、<1MB，与 GitHub Social preview 同一张）。
// 用 Astro.site 拼绝对 URL —— OG 规范要求 og:image / og:url 必须是绝对地址。
const site = Astro.site ?? new URL('https://agentia-web.pages.dev');
// ⚠️ canonical / og:url 必须是**干净形态**（`/docs` 而非 `/docs.html`）。
// Cloudflare Pages 对产物里存在的 `x.html` 一律 308 到 `/x`（实测 /index.html → /、
// /docs.html → /docs、/404.html → /404），所以 `.html` 正是**会重定向**的形态；
// og:url 指到它等于声明了一个「跳转前的地址」。`build.format: 'file'` 下
// `Astro.url.pathname` 是 `/docs.html`，这里去掉扩展名。
// ⚠️ 替换成**空串**而不是 `'/'`：`'/index.html'.replace(/index\.html$/, '/')` 会得到 `'//'`
// （前导斜杠还在）—— 那是协议相对 URL，`new URL('//', site)` 直接抛 Invalid URL（构建红）。
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(cleanPath, site).href;
const ogImage = new URL('og.png', site).href;

// ── 语言面（2026-10-08 官网英文版）────────────────────────────────────────
// `lang` 由各页传入（`'zh' | 'en'`，缺省中文）。这里派生出「同一页在两种语言下的地址」，
// 供 Nav 的切换控件与 <head> 的 hreflang 复用 —— 页面本身不再各算一次。
//
// ⚠️ 三条约束，改这段前先读：
//   ① 路径一律**干净形态**：`build.format: 'file'` 下 `Astro.url.pathname` 是 `/docs.html`，
//      扩展名已在上面剥掉（cleanPath）。
//   ② ⚠️ **`build.format: 'file'` 是扁平的**：`src/pages/en/index.astro` 产出 `dist/en.html`，
//      不是 `dist/en/index.html` ⇒ 英文**首页的地址是 `/en`（无尾斜杠）**，
//      其余是 `/en/docs`、`/en/api`…（与中文站的 `/`、`/docs` 同构）。
//      用户手输的 `/en/` 由 `public/_worker.js` 308 到 `/en`（产物里没有 `en/index.html`）。
//   ③ hreflang 的两个地址必须**互指且各自 canonical 指向自身**：本仓的产物守卫会核
//      canonical 与该页在 sitemap 里的 loc 一致；两版若互指 canonical，守卫当场红。
const isEn = lang === 'en';
const htmlLang = isEn ? 'en' : 'zh-CN';
// 中文侧路径：英文页去掉 `/en` 前缀（`/en` → `/`、`/en/docs` → `/docs`）
const zhPath = isEn ? cleanPath.replace(/^\/en(\/|$)/, '/') : cleanPath;
const enPath = isEn ? cleanPath : zhPath === '/' ? '/en' : `/en${zhPath}`;
const zhUrl = new URL(zhPath, site).href;
const enUrl = new URL(enPath, site).href;

// AI agent 指引（llms.txt directive）。四页共用，所以放在外壳里而不是各页手抄四遍
// ——「文档站的读者已经包括 agent」，而 agent 从**深层页**进来时并不知道站上还有
// /llms.txt 与 /llms-full.txt（AFDocs 的 llms-txt-directive-html 检查的就是这件事）。
//
// ⚠️ 三个约束，改这段前先读：
//   ① 用 clip / clip-path 视觉隐藏，**不要**换成 display:none / hidden / aria-hidden ——
//      前两者会被 HTML 解析器或转换器剥离，这条指引正是要能被「HTML→Markdown 的 agent」读到；
//      加 aria-hidden 则等于对无障碍树撒谎（它是给机器读的正文，不是装饰）。
//   ② URL 写**纯文本**，不要套 <a>：HTML→Markdown 转换常丢弃链接标签、只留锚文本，
//      而纯文本路径在转换后仍完整可读。
//   ③ 留在 <body> 最前：AFDocs 按「命中位置 / 正文长度」判定是否「near the top」（≤10%），
//      放到页面尾部会被判成 buried（>50%）而降级。它必须在 <Nav> 之前 —— <nav> 整段会被剥离。
const llmsIndex = new URL('llms.txt', site).href;
const llmsFull = new URL('llms-full.txt', site).href;
const llmsHint = isEn
  ? `For AI agents: the complete documentation index is available at ${llmsIndex}, and the full documentation bundle (the single-source usage guide, plain text, in Chinese) is available at ${llmsFull}.`
  : `For AI agents: the complete documentation index is available at ${llmsIndex}, and the full documentation bundle (the single-source usage guide in plain text) is available at ${llmsFull}.`;
---
<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 语言自动检测：必须在**任何样式与内容之前**同步执行，否则会先画出中文再闪成英文。
         本脚本是 is:inline（不被 Astro 打包、不延后），且刻意放在 <head> 最前。
         ⚠️ 判据三条（与 docs/plans/2026-10-08-website-i18n.md §3 一致）：
           ① localStorage['agentia-lang']（用户**显式**切换过）优先；
           ② 否则看 navigator.languages 里有没有中文；
           ③ 拿不到语言信息 ⇒ **不跳**（宁可停在默认的中文版，也不要猜）。
         ⚠️ 自动跳转**只读不写** localStorage —— 写了就等于把「自动」记成「用户选择」，
            用户之后手动点回中文会被立刻弹走。只有 Nav 的切换控件才写。
         ⚠️ 用 location.replace（不留历史条目），并带上 query 与 hash。 -->
    <script is:inline>
      (function () {
        try {
          var K = 'agentia-lang';
          var stored = null;
          try {
            stored = localStorage.getItem(K);
          } catch (e) {
            stored = null;
          }
          var p = location.pathname;
          // 交给 Cloudflare Pages 的 308 去收敛 `.html` 形态（本脚本不参与）
          if (/\.html?$/.test(p)) return;
          var isEn = p === '/en' || p.indexOf('/en/') === 0;
          var wantEn;
          if (stored === 'zh' || stored === 'en') {
            wantEn = stored === 'en';
          } else {
            var langs =
              navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || ''];
            var known = false;
            var hasZh = false;
            for (var i = 0; i < langs.length; i++) {
              var l = langs[i];
              if (!l) continue;
              known = true;
              if (/^zh\b/i.test(l)) {
                hasZh = true;
                break;
              }
            }
            if (!known) return;
            wantEn = !hasZh;
          }
          if (wantEn === isEn) return;
          var zhPath = isEn ? p.replace(/^\/en(\/|$)/, '/') : p;
          var target = wantEn ? (zhPath === '/' ? '/en' : '/en' + zhPath) : zhPath;
          location.replace(target + location.search + location.hash);
        } catch (e) {
          /* 任何异常都不该影响页面可用性 */
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- 绝对路径：404 页会以**任意**请求路径被送出（/foo/bar/baz 也回它），
         相对地址在那里会按 /foo/bar/ 解析 ⇒ 图标取不到。 -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <!-- 同一页的两种语言互指；x-default 指中文版（站点默认入口）。
         ⚠️ 两版**各自 canonical 指向自身**（上面那行），alternate 才指对方 ——
         若两版互指 canonical，产物守卫会判「canonical 与该页 sitemap loc 不一致」。 -->
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <!-- 社交分享：Open Graph（Facebook/微信/Slack 等） + Twitter 大图卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agentia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={isEn ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={isEn ? 'Agentia — a declarative framework for agent services' : 'Agentia —— 声明式 agent 服务开发框架'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {preloadFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
  </head>
  <body class={`page-${page}`}>
    <div
      class="llms-hint"
      style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0"
    >{llmsHint}</div>
    <div class="grid-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress"></span></div>

    <Nav page={page} lang={lang} zhHref={zhPath} enHref={enPath} />

    <slot />

    <Footer links={footerLinks} lang={lang} />

    <slot name="scripts" />
  </body>
</html>

<script>
  // 窄屏导航折叠：零依赖，四页共用
  import '../scripts/nav-collapse.js';
</script>
