{
  "name": "@migor/cli",
  "version": "0.8.3",
  "description": "Agentia 框架命令行工具：create 脚手架 + g 能力生成 + dev 本地可观测面板（trace inspector）",
  "type": "module",
  "bin": {
    "agentia": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": "retrychx/agentia",
  "homepage": "https://agentia-web.pages.dev",
  "bugs": {
    "url": "https://github.com/retrychx/agentia/issues"
  },
  "license": "MIT",
  "keywords": [
    "agentia",
    "agent",
    "cli",
    "scaffold"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.templates.json && node scripts/copy-assets.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "node ../../scripts/check-release.mjs && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
