{
  "name": "agentia",
  "version": "0.0.1",
  "private": true,
  "description": "面向应用开发者的声明式 agent 服务开发框架 —— NestJS 模式：主 agent 调度 tool/skill/subagent/prompt，自研运行时，最终形态为流水线（pipeline）服务。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cli": "tsc -p packages/cli/tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:run": "npm run build && node scripts/smoke-run.mjs",
    "smoke:turn2": "tsx scripts/smoke-turn2.ts",
    "smoke:turn3": "tsx scripts/smoke-turn3.ts",
    "smoke:turn4": "tsx scripts/smoke-turn4.ts",
    "smoke:turn5": "tsx scripts/smoke-turn5.ts",
    "smoke:turn6": "tsx scripts/smoke-turn6.ts",
    "smoke:turn7": "npm run build && npm run build:cli && tsx scripts/smoke-turn7.ts",
    "live": "npm run build && node examples/live.mjs",
    "live:skill": "tsx examples/live-skill.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  }
}
